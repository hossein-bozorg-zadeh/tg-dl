# Copy this file to .env and fill in your values
# Get a token from @BotFather in Telegram

BOT_TOKEN=your-bot-token-here

# Owner (full admin, manages access)
OWNER_ID=0

# Comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
ALLOWED_USERS=

# Private channel used to store downloaded files + logs.
# Add the bot as an ADMIN to this channel first. Get the channel id:
#  - after running the bot once, it logs "Storage channel: ..." or errors
#  - or use @userinfobot and forward a post from the channel
# Example: -1001234567890
CHANNEL_ID=0

# aria2 RPC settings (must match aria2.conf)
ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc
ARIA2_SECRET=aria2botsecret

# Directory where downloaded files are stored
DOWNLOAD_DIR=/workspace/aria2-bot/downloads

# MTProto credentials for sending files up to 2 GiB (optional).
# Get them from https://my.telegram.org -> API development tools.
# If empty, bot falls back to Bot API (50 MiB limit).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Cooldown between requests for non-authorized users (seconds)
COOLDOWN_SECONDS=10

# Channel cache lifetime for re-sending the same link (days)
CACHE_TTL_DAYS=7

# Split threshold / part size for very large files (bytes)
# Files above SPLIT_THRESHOLD are split into parts of SPLIT_PART_SIZE.
SPLIT_THRESHOLD=2147483648
SPLIT_PART_SIZE=1610612736

# Timeout for external tools (yt-dlp etc.)
PROCESS_MAX_TIMEOUT=3700

# Proxy for yt-dlp / direct downloads (optional, e.g. http://127.0.0.1:8080)
HTTP_PROXY=

# Comma-separated proxy list used by yt-dlp, rotated per request.
# Helps avoid YouTube bot-detection / login prompts. Empty = no proxy.
# Example: socks5://127.0.0.1:9050,http://user:pass@host:port
YTDLP_PROXIES=

# Optional cookies file for yt-dlp (cookies.txt exported from your browser).
# Fixes YouTube "Sign in to confirm you're not a bot" errors.
YTDLP_COOKIES=

